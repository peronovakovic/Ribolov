{
  "realm": "ribolov",
  "enabled": true,
  "displayName": "Ribolov",
  "registrationAllowed": true,
  "resetPasswordAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "sslRequired": "external",
  "clients": [
    {
      "clientId": "ribolov-web",
      "name": "Ribolov web portal",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${RIBOLOV_WEB_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:8080/login/oauth2/code/keycloak",
        "http://localhost:5173/login/oauth2/code/keycloak"
      ],
      "webOrigins": [
        "http://localhost:5173"
      ],
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:5173/",
        "default.acr.values": "2",
        "minimum.acr.value": "2"
      },
      "protocolMappers": [
        {
          "name": "authentication-level",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-acr-mapper",
          "config": {
            "id.token.claim": "true",
            "access.token.claim": "true"
          }
        },
        {
          "name": "email",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "config": {
            "user.attribute": "email",
            "claim.name": "email",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "email-verified",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "config": {
            "user.attribute": "emailVerified",
            "claim.name": "email_verified",
            "jsonType.label": "boolean",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ],
      "defaultClientScopes": [
        "profile",
        "email",
        "roles",
        "web-origins"
      ]
    },
    {
      "clientId": "ribolov-android",
      "name": "Ribočuvarska aplikacija",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "ba.ribolov.android:/oauth2redirect"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "ribolov-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "ribolov-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [],
  "browserFlow": "ribolov-browser",
  "attributes": {
    "acr.loa.map": "{\"1\": 1, \"2\": 2}"
  },
  "authenticatorConfig": [
    {
      "alias": "ribolov-level-1",
      "config": {
        "loa-condition-level": "1",
        "loa-max-age": "300"
      }
    },
    {
      "alias": "ribolov-level-2",
      "config": {
        "loa-condition-level": "2",
        "loa-max-age": "0"
      }
    }
  ],
  "authenticationFlows": [
    {
      "alias": "ribolov-browser",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "authenticatorFlow": false,
          "userSetupAllowed": false,
          "authenticator": "auth-cookie"
        },
        {
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "authenticatorFlow": true,
          "userSetupAllowed": false,
          "flowAlias": "ribolov-authentication"
        }
      ]
    },
    {
      "alias": "ribolov-authentication",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "CONDITIONAL",
          "priority": 10,
          "authenticatorFlow": true,
          "userSetupAllowed": false,
          "flowAlias": "ribolov-password"
        },
        {
          "requirement": "CONDITIONAL",
          "priority": 20,
          "authenticatorFlow": true,
          "userSetupAllowed": false,
          "flowAlias": "ribolov-otp"
        }
      ]
    },
    {
      "alias": "ribolov-password",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "REQUIRED",
          "priority": 10,
          "authenticatorFlow": false,
          "userSetupAllowed": false,
          "authenticator": "conditional-level-of-authentication",
          "authenticatorConfig": "ribolov-level-1"
        },
        {
          "requirement": "REQUIRED",
          "priority": 20,
          "authenticatorFlow": false,
          "userSetupAllowed": false,
          "authenticator": "auth-username-password-form"
        }
      ]
    },
    {
      "alias": "ribolov-otp",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "REQUIRED",
          "priority": 10,
          "authenticatorFlow": false,
          "userSetupAllowed": false,
          "authenticator": "conditional-level-of-authentication",
          "authenticatorConfig": "ribolov-level-2"
        },
        {
          "requirement": "REQUIRED",
          "priority": 20,
          "authenticatorFlow": false,
          "userSetupAllowed": false,
          "authenticator": "auth-otp-form"
        }
      ]
    }
  ],
  "registrationEmailAsUsername": true,
  "verifyEmail": true,
  "editUsernameAllowed": false,
  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "noreply@ribolov.local",
    "fromDisplayName": "Ribolov",
    "auth": "false",
    "ssl": "false",
    "starttls": "false"
  },
  "requiredActions": [
    {
      "alias": "VERIFY_EMAIL",
      "name": "Verify Email",
      "providerId": "VERIFY_EMAIL",
      "enabled": true,
      "defaultAction": true,
      "priority": 50
    },
    {
      "alias": "CONFIGURE_TOTP",
      "name": "Configure OTP",
      "providerId": "CONFIGURE_TOTP",
      "enabled": true,
      "defaultAction": true,
      "priority": 40
    }
  ]
}
