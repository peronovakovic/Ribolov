# Local development only. Copy to .env; never use these values in production.
POSTGRES_OWNER_PASSWORD=local-owner-password
DATABASE_URL=jdbc:postgresql://localhost:5432/ribolov
DATABASE_USERNAME=ribolov_app
DATABASE_PASSWORD=local-app-password
MIGRATION_USERNAME=ribolov_owner
MIGRATION_PASSWORD=local-owner-password
KEYCLOAK_DB_PASSWORD=local-keycloak-db-password
KEYCLOAK_ADMIN_PASSWORD=local-keycloak-admin-password
OIDC_ISSUER=http://localhost:8180/realms/ribolov
OIDC_WEB_SECRET=local-web-client-secret
WEB_URL=http://localhost:5173/
SESSION_COOKIE_SECURE=false
# Public LOCAL-ONLY test key. Generate a private 32-byte base64 key for each shared environment.
INVITATION_SIGNING_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
INVITATION_DELIVERY_ENABLED=true
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@ribolov.local
SMTP_STARTTLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
